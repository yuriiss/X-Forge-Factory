# X-Forge — copy to .env.local, or run `npm run setup` to write it interactively.
# .env.local is git-ignored and must never be committed.

# ── Magnific ─────────────────────────────────────────────────────────────────
# Server-side only: every outbound call is made by a route handler, and the browser
# never sees this value. Get one at magnific.com → user → API keys.
MAGNIFIC_API_KEY=

# Shown once when the key is created. Only needed if you pass webhook_url on jobs;
# without it deliveries are recorded but never trusted.
MAGNIFIC_WEBHOOK_SECRET=

# ── Engine ───────────────────────────────────────────────────────────────────
FORGE_PORT=7777
FORGE_PUBLIC_URL=http://127.0.0.1:7777

# Engine state: database, OAuth session, catalogue cache. Outside the web root.
FORGE_HOME=~/.x-forge

# Where generated assets are kept. Point this at somewhere you actually browse — an
# Obsidian vault, a project folder — and X-Forge sorts them into image/ video/ audio/
# 3D/ vector/ with readable names and a markdown note beside each file.
# Defaults to $FORGE_HOME/vault.
FORGE_VAULT_DIR=~/Obsidian/X-FORGE

# Master key for credential envelope encryption — 32 bytes of hex.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it means re-entering the API key.
FORGE_MASTER_KEY=

# Jobs estimated above this wait for a human on a one-time approval link.
FORGE_APPROVAL_THRESHOLD=400
# Jobs that would drop the balance below this are rejected — never downgraded to fit.
FORGE_CREDIT_FLOOR=0
# Video is the expensive family, so it is off until you say otherwise.
FORGE_VIDEO_ENABLED=0

# ── Outbound shaping ─────────────────────────────────────────────────────────
# Magnific allows 50 requests per minute per key; stay under it.
FORGE_RPM_LIMIT=45
FORGE_GLOBAL_RPM=45
FORGE_MAX_CONCURRENT=3
FORGE_RETENTION_DAYS=30
# Balance drift past this parks the engine in safe_mode until a human resumes it.
FORGE_DRIFT_THRESHOLD=2000

# ── Optional ─────────────────────────────────────────────────────────────────
# Adopt an MCP session another client on this machine already authorised, instead of
# signing in again. Colon-separated paths to their mcp.json files. Off unless set.
FORGE_MCP_IMPORT=
